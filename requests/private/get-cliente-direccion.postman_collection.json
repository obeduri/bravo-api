            "direccion",
            "list"
          ],
          "query": [
            {
              "key": "withZonaDelivery",
              "value": "1"
            }
          ]
        },
        "description": "## Direcciones del Cliente y Zona de Delivery\n\nRecupera las direcciones de entrega guardadas en el perfil del usuario autenticado, junto con su zona de reparto (*delivery zone*) y tienda asociada.\n\n> [!IMPORTANT]\n> **Requiere Autenticación:** Cabecera `X-Auth-Token` obligatoria.\n\n### Parámetros de Consulta (Query Params)\n- `withZonaDelivery`: `1` para incluir la zona geográfica y tienda asignada para delivery."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "pm.test(\"Código de estado HTTP es 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Retorna lista de direcciones del usuario\", function () {\r",
              "    const res = pm.response.json();\r",
              "    pm.expect(res).to.have.property(\"data\");\r",
              "});\r"
            ]
          }
        }
      ]
    }
