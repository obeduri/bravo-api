  },
  "item": [
    {
      "name": "LOGOUT",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "User-Agent",
            "value": "{{User-Agent}}",
            "type": "text"
          },
          {
            "key": "X-Auth-Token",
            "value": "{{X-Auth-Token}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "https://bravova-api.superbravo.com.do/private/auth/logout?token={{X-Auth-Token}}",
          "protocol": "https",
          "host": [
            "bravova-api",
            "superbravo",
            "com",
            "do"
          ],
          "path": [
            "private",
            "auth",
            "logout"
          ],
          "query": [
            {
              "key": "token",
              "value": "{{X-Auth-Token}}"
            }
          ]
        },
        "description": "## Cierre de Sesión (Logout)\n\nInvalida el token de sesión activo en el servidor para revocar el acceso a recursos privados.\n\n### Parámetros de Consulta (Query Params)\n- `token`: Valor del token a invalidar (proporcionado mediante `{{X-Auth-Token}}`).\n\n### Automatización Postman\nEl script de prueba limpia automáticamente la variable `X-Auth-Token` tras un cierre exitoso."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "pm.test(\"Sesión cerrada exitosamente (200 OK)\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Limpiar el token de sesión activo en Postman\r",
              "pm.environment.unset(\"X-Auth-Token\");\r",
              "pm.collectionVariables.set(\"X-Auth-Token\", \"\");\r"
            ]
          }
        }
      ]
    }
  ],
