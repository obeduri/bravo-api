{
  "info": {
    "_postman_id": "27d242c8-3c83-4e26-b18c-c7fb036cd44c",
    "name": "PUBLIC - LOGIN",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "LOGIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Código de estado HTTP es 200 OK\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Respuesta contiene token de sesión\", function () {\r",
              "    pm.expect(response).to.have.property(\"data\");\r",
              "    pm.expect(response.data).to.have.property(\"token\");\r",
              "    pm.expect(response.data.token).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"Respuesta contiene datos de usuario y sesión\", function () {\r",
              "    pm.expect(response.data).to.have.property(\"sesion\");\r",
              "});\r",
              "\r",
              "if (response && response.data && response.data.token) {\r",
              "    pm.environment.set(\"X-Auth-Token\", response.data.token);\r",
              "    pm.collectionVariables.set(\"X-Auth-Token\", response.data.token);\r",
              "}\r"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
